#include <stdio.h>
#include <string.h>

int main()
{
    char files[20][30];
    int n, i;

    printf("Enter number of files: ");
    scanf("%d", &n);

    for(i = 0; i < n; i++)
    {
        printf("Enter file %d name: ", i + 1);
        scanf("%s", files[i]);
    }

    printf("\nFiles in Single Level Directory:\n");
    for(i = 0; i < n; i++)
    {
        printf("%d. %s\n", i + 1, files[i]);
    }

    return 0;
}
