#include<stdio.h>
#include<fcntl.h>
#include<unistd.h>

int main()
{
    int fd;
    char writebuf[]="Operating System Lab";
    char readbuf[50];

    fd=open("sample.txt",O_CREAT|O_RDWR,0644);

    write(fd,writebuf,sizeof(writebuf));

    close(fd);

    fd=open("sample.txt",O_RDONLY);

    read(fd,readbuf,sizeof(readbuf));

    printf("File Content: %s\n",readbuf);

    close(fd);

    return 0;
}
