#include <stdio.h>

int main()
{
    FILE *fp;
    char data[100];

    // Create and write
    fp = fopen("sample.txt", "w");

    printf("Enter data: ");
    scanf(" %[^\n]", data);

    fprintf(fp, "%s", data);
    fclose(fp);

    // Read
    fp = fopen("sample.txt", "r");

    printf("\nFile Content: ");
    fgets(data, 100, fp);
    printf("%s\n", data);

    fclose(fp);

    // Append
    fp = fopen("sample.txt", "a");

    fprintf(fp, " New data added.");
    fclose(fp);

    printf("Data appended successfully\n");

    return 0;
}
