#include <stdio.h>
#include <stdlib.h>

int main()
{
    int request[50], n, head, i, movement = 0;

    printf("Enter number of requests: ");
    scanf("%d", &n);

    printf("Enter request queue:\n");
    for(i = 0; i < n; i++)
        scanf("%d", &request[i]);

    printf("Enter initial head position: ");
    scanf("%d", &head);

    printf("\nOrder: %d", head);

    for(i = 0; i < n; i++)
    {
        movement += abs(head - request[i]);
        head = request[i];

        printf(" -> %d", head);
    }

    printf("\nTotal Head Movement = %d\n", movement);

    return 0;
}
