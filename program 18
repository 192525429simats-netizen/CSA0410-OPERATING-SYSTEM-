#include<stdio.h>
#include<stdlib.h>

int mutex=1;
int full=0;
int empty=3,x=0;

int wait(int s)
{
    return --s;
}

int signal(int s)
{
    return ++s;
}

int main()
{
    int choice;

    while(1)
    {
        printf("\n1. Producer");
        printf("\n2. Consumer");
        printf("\n3. Exit");
        printf("\nEnter your choice: ");
        scanf("%d",&choice);

        switch(choice)
        {
            case 1:
                if((mutex==1)&&(empty!=0))
                {
                    mutex=wait(mutex);
                    full=signal(full);
                    empty=wait(empty);
                    x++;
                    printf("Producer produced item %d\n",x);
                    mutex=signal(mutex);
                }
                else
                {
                    printf("Buffer Full\n");
                }
                break;

            case 2:
                if((mutex==1)&&(full!=0))
                {
                    mutex=wait(mutex);
                    full=wait(full);
                    empty=signal(empty);
                    printf("Consumer consumed item %d\n",x);
                    x--;
                    mutex=signal(mutex);
                }
                else
                {
                    printf("Buffer Empty\n");
                }
                break;

            case 3:
                exit(0);
        }
    }
}
